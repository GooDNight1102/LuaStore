{
  "name": "lua-fashion",
  "version": "4.0.0",
  "description": "Website bán hàng thời trang nữ LỤA — kiến trúc SOA (API Gateway + 8 service), Node.js (Express), PostgreSQL (Supabase), triển khai Vercel",
  "main": "app.js",
  "private": true,
  "scripts": {
    "setup": "node --env-file=.env scripts/setup.js",
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1"
  }
}
